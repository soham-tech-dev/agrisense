# Firebase Configuration
# ─────────────────────────────────────────────────────────────────
# Go to https://console.firebase.google.com → Your Project →
# Project Settings → General → Your apps → Web app
# Copy the values from the firebaseConfig object below into this file.
# ─────────────────────────────────────────────────────────────────
# IMPORTANT: Never commit .env to source control.
# Only commit this .env.example file.
# ─────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Voice provider (keep as-is)
VITE_VOICE_PROVIDER=webspeech

# ===================================================================
# AGRISENSE — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ===================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ===================================================================

# -------------------------------------------------------------------
# APP CONFIGURATION
# -------------------------------------------------------------------
APP_NAME=AgriSense
VERSION=1.0.0
ENVIRONMENT=production                       # 'development' or 'production'
LOG_LEVEL=INFO                                # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
CORS_ORIGINS=http://localhost:5173,http://localhost:8000  # Comma-separated allowed origins or '*'

# -------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -------------------------------------------------------------------
# Secrets must be strong, random 32+ character strings in production!
JWT_SECRET=agrisense_production_jwt_secret_key_change_me_32bytes
SECRET_KEY=agrisense_production_jwt_secret_key_change_me_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080             # 7 days
DEV_OTP_CODE=123456                           # Fallback OTP for testing (disabled in strict prod mode)

# -------------------------------------------------------------------
# DATABASE CONFIGURATION (SQLAlchemy / PostgreSQL / SQLite)
# -------------------------------------------------------------------
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://agrisense_user:agrisense_password@database:5432/agrisense_db
# Local SQLite fallback:
DATABASE_URL=sqlite:///./agrisense_dev.db

POSTGRES_USER=agrisense_user
POSTGRES_PASSWORD=agrisense_password
POSTGRES_DB=agrisense_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# -------------------------------------------------------------------
# VECTOR DATABASE & EMBEDDINGS (ChromaDB + sentence-transformers)
# -------------------------------------------------------------------
VECTOR_DB_PATH=./chroma_db
CHROMA_DB_DIR=./chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_DISTANCE_THRESHOLD=0.65            # Minimum cosine distance cutoff for relevant documents

# -------------------------------------------------------------------
# AI / LLM ADVISOR ENGINE (Anthropic Claude API)
# -------------------------------------------------------------------
# Required for real AI query generation. If missing, RAG Advisor returns fallback rule-based responses.
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022

# -------------------------------------------------------------------
# EXTERNAL AGRICULTURAL DATA APIS
# -------------------------------------------------------------------
# OpenWeatherMap API Key for live weather forecasts and advisories
OPENWEATHER_API_KEY=your_openweather_map_api_key_here

# Data.gov.in API Key for live APMC Mandi commodity market prices
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# In-memory API Response Caching
CACHE_TTL_MINUTES=30                          # TTL for weather and mandi price cache

# -------------------------------------------------------------------
# STORAGE CONFIGURATION (Uploaded Crop Images & Static Assets)
# -------------------------------------------------------------------
STORAGE_TYPE=local                            # 'local' or 's3'
LOCAL_STORAGE_DIR=static/uploads              # Directory relative to backend root
MAX_IMAGE_SIZE_MB=10                          # Maximum leaf image upload size in MB

# -------------------------------------------------------------------
# VOICE & MULTILINGUAL CONFIGURATION
# -------------------------------------------------------------------
TTS_ENGINE=web_speech_api                     # 'web_speech_api' or 'gtts'
STT_ENGINE=web_speech_api                     # 'web_speech_api' or 'whisper'
DEFAULT_LANGUAGE=mr                           # 'mr' (Marathi) or 'en' (English)

# -------------------------------------------------------------------
# PROJECT TEAM DEPLOYMENT CHECKLIST
# -------------------------------------------------------------------
# 1. Provide valid ANTHROPIC_API_KEY for real Claude LLM synthesis.
# 2. Provide valid OPENWEATHER_API_KEY for real live weather forecasts.
# 3. Provide valid DATA_GOV_IN_API_KEY for real live mandi prices.
# 4. For full CNN disease detection, place trained MobileNetV2 weights at:
#    backend/ml/models/mobilenetv2_crop_disease.h5
